{
  "name": "norn-release-tooling",
  "private": true,
  "description": "Release tooling for the Norn runtime",
  "license": "Apache-2.0",
  "scripts": {
    "release:guard-clean-tree": "test -z \"$(git status --porcelain)\" || (echo 'Working tree is not clean' && git status --short && exit 1)",
    "release": "npm run release:guard-clean-tree && semantic-release --no-ci",
    "release:dry": "npm run release:guard-clean-tree && semantic-release --no-ci --dry-run"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^6.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "semantic-release": "^25.0.0"
  }
}
